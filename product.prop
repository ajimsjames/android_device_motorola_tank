# e-SIM
masterclear.allow_retain_esim_profiles_after_fdr=true
ro.telephony.esim_slot_id=1

# Moto
ro.vendor.product.display=motorola edge 50

# Google
ro.opa.device_model_id=motorola-tank

# Radio
ro.vendor.radio.imei.sv=27

# SKU specific properties
import /product/etc/hardware.sku.${ro.boot.hardware.sku}.prop

# SetupWizard
ro.setupwizard.mode=DISABLED

# About Phone
ro.product.marketname=motorola edge 50
ro.infinity.soc=Snapdragon 7 Gen 1 Accelerated Edition
ro.infinity.camera=50MP + 13MP + 10MP
